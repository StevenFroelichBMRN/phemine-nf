// phemine-nf : proteome mining for engineerable phenylalanine binders
// Heavy compute runs on AWS Batch via Seqera Platform.

manifest {
    name            = 'phemine-nf'
    description     = 'Mine the human proteome for proteins engineerable to bind/transform L-phenylalanine'
    mainScript      = 'main.nf'
    nextflowVersion = '>=23.10.0'
    version         = '0.1.0'
}

nextflow.enable.dsl = 2

params {
    // S3 layout — every stage writes under its own prefix so re-runs can skip completed work
    s3_base   = 's3://r6333-pep-nppc-oi-bmn333-dev/phemine'
    outdir    = "${params.s3_base}/raw"
    dbdir     = "${params.s3_base}/db"

    // Source URLs (pinned where the source supports it)
    uniprot_query = 'reviewed:true AND organism_id:9606'
    // Use the versioned path: .../alphafold/latest/... 404s. ~5.1 GB.
    afdb_url      = 'https://ftp.ebi.ac.uk/pub/databases/alphafold/v4/UP000005640_9606_HUMAN_v4.tar'
    pfam_url      = 'https://ftp.ebi.ac.uk/pub/databases/Pfam/current_release/Pfam-A.hmm.gz'

    // Inputs supplied per-channel run
    ref_fasta      = null
    ref_structures = null
    motif_library  = null
    shortlist      = null
    chunk_size     = 2000
    publish_mode   = 'copy'
}

// Wave builds images from the conda specs declared on each process.
// This avoids depending on third-party image tags staying available.
// Wave turns each process's `conda` directive into a container image built on demand.
// conda.enabled must stay FALSE: with it on, Nextflow tries to materialise conda envs
// itself and fails on an S3 work dir ("Cannot store Conda environments to a remote
// work directory").
wave {
    enabled  = true
    strategy = ['conda']
}
conda {
    enabled = false
}

process {
    // task.exitStatus is null when a task fails before the container reports one,
    // so guard it explicitly rather than indexing into the retry list.
    errorStrategy = { (task.exitStatus != null && task.exitStatus in [104,134,137,138,139,143,247,175]) ? 'retry' : 'finish' }
    maxRetries    = 2

    cpus   = 2
    memory = 8.GB

    withLabel: tiny    { cpus = 1;  memory = 2.GB  }
    withLabel: small   { cpus = 2;  memory = 8.GB  }
    withLabel: medium  { cpus = 8;  memory = 32.GB }
    withLabel: large   { cpus = 16; memory = 64.GB }
    withLabel: xlarge  { cpus = 32; memory = 128.GB }
    withLabel: network { cpus = 2;  memory = 8.GB; maxForks = 4 }
}

profiles {
    awsbatch {
        process.executor = 'awsbatch'
        aws {
            region = 'us-west-2'
            batch {
                maxParallelTransfers  = 8
                maxTransferAttempts   = 3
                delayBetweenAttempts  = '30 sec'
                cliPath               = '/usr/local/bin/aws'
            }
        }
    }
    standard {
        process.executor = 'local'
    }
}

timeline.overwrite = true
report.overwrite   = true
trace.overwrite    = true
dag.overwrite      = true
